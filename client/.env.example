# Frontend API base URL (required for production when API is hosted on another domain)
VITE_API_BASE_URL=https://your-api-domain.example.com/api

# Optional explicit SignalR hub URL.
# If omitted, the app derives it from VITE_API_BASE_URL (or current origin as fallback).
VITE_SIGNALR_HUB_URL=https://your-api-domain.example.com/hubs/tracking
